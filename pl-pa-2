              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
                <span style="font-size:12px;color:#5A6472">${f.n} selected</span>
                <button type="button" data-click="${on(f.close)}" style="font-size:12px;font-weight:700;min-height:32px;padding:0 14px;border-radius:8px;border:0;background:#003874;color:#FFFFFF;cursor:pointer">Done</button>
              </div>
            </div>` : ''}
          </div>
          ${f.n ? `<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px">${f.sel.map(v => `<button type="button" data-click="${on(v.remove)}" aria-label="Remove ${esc(v.val)}" style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;border-radius:999px;padding:0 6px 0 9px;min-height:24px;border:0;background:#003874;color:#FFFFFF;cursor:pointer">${esc(v.val)}<span aria-hidden="true" style="font-size:13px;opacity:.8">×</span></button>`).join('')}${f.more ? `<span style="font-size:11px;color:#5A6472;align-self:center;padding-left:4px">+${f.more} more</span>` : ''}</div>` : ''}
        </div>`).join('')}</div>` : ''}
      </div>`).join('')}
    </section>`;

    return `<div style="padding:20px 16px 24px"><div style="max-width:1440px;margin:0 auto;display:flex;flex-direction:column;gap:16px">
      ${header}${kpis}${chipRow}
      <div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
        <div style="flex:999 1 640px;min-width:0;display:flex;flex-direction:column;gap:16px">${funnel}${trend}</div>
        <aside style="flex:1 1 320px;min-width:0;max-width:100%;display:flex;flex-direction:column;gap:16px">${filters}</aside>
      </div>
      ${mixSection(V)}
      <p style="margin:0;font-size:11px;color:#5A6472">Mock-up data. 1 to 5 Nov offers and disbursals match the daily-mailer check; every other day and the filter values are illustrative. Data runs 1 Jul to 8 Nov 2026.</p>
    </div></div>`;
  }

  // ------------------------------------------------------------------ render + events
  const app = document.getElementById('app');
  function render() {
    const ae = document.activeElement;
    const keepId = ae && ae.id ? ae.id : null;
    const caret = keepId && ae.selectionStart != null ? ae.selectionStart : null;
    const oldList = document.getElementById('ddlist');
    const listScroll = oldList ? oldList.scrollTop : 0;
    H = [];
    app.innerHTML = view(compute());
    if (keepId) {
      const el = document.getElementById(keepId);
      if (el) { el.focus(); if (caret != null && el.setSelectionRange) el.setSelectionRange(caret, caret); }
    }
    const dl = document.getElementById('ddlist'); if (dl && listScroll) dl.scrollTop = listScroll;
    if (S.ddFocus) { S.ddFocus = false; const d = document.getElementById('ddsearch'); if (d) d.focus(); }
  }
  app.addEventListener('click', (e) => {
    const el = e.target.closest('[data-click]');
    if (S.dd && !e.target.closest('[data-dd-root]')) { S.dd = null; S.ddq = ''; if (!el || el.disabled) { render(); return; } }
    if (el && !el.disabled) H[+el.getAttribute('data-click')](e);
  });
  app.addEventListener('change', (e) => { const el = e.target.closest('[data-change]'); if (el) H[+el.getAttribute('data-change')](e); });
  app.addEventListener('input', (e) => { const el = e.target.closest('[data-input]'); if (el) H[+el.getAttribute('data-input')](e); });
  app.addEventListener('mouseover', (e) => { const el = e.target.closest('[data-hover]'); if (el) H[+el.getAttribute('data-hover')](e); });
  app.addEventListener('mouseout', (e) => { const el = e.target.closest('[data-leave]'); if (el && !el.contains(e.relatedTarget)) H[+el.getAttribute('data-leave')](e); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && (S.pcal || S.tcal || S.dd)) set({ pcal: false, tcal: false, dd: null, ddq: '' }); });
  render();
  FIRST = false;
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce) { INTRO = 1; render(); }
  else {
    const t0 = performance.now();
    const tick = (now) => {
      INTRO = Math.min(1, (now - t0) / 1100);
      const V = compute();
      document.querySelectorAll('[data-kpi]').forEach(el => { el.textContent = V.kpis[+el.getAttribute('data-kpi')].value; });
      if (INTRO < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
})();
</script>
</body>
</html>
