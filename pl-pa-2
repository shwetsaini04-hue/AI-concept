<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PL-PA overall, Kotak</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;background:#F4F6FA}
body{font-family:"Segoe UI",system-ui,-apple-system,sans-serif;color:#0E2240}
a{color:#003874}a:hover{color:#00254D}
select,input,button{font:inherit}
button{color:inherit}
button:focus-visible,select:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid #003874;outline-offset:2px}
button:disabled{cursor:default}
.blink{display:inline-block;animation:kpiBlink 1.2s ease-in-out infinite}
@keyframes kpiBlink{0%,100%{opacity:1}50%{opacity:0.15}}
@media (prefers-reduced-motion: reduce){.blink{animation:none}}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.grow{display:flex;transform-origin:left center;animation:growX .9s cubic-bezier(.2,.8,.2,1) both}
@keyframes growX{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.notch{animation:fadeIn .5s ease .75s both}
.pulse{animation:fadeIn .5s ease .75s both,leakPulse 2.2s ease-in-out 1.4s infinite}
.pulse2{animation:leakPulse 2.2s ease-in-out infinite}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes leakPulse{0%,100%{box-shadow:0 0 0 0 rgba(237,28,36,.35)}50%{box-shadow:0 0 0 7px rgba(237,28,36,0)}}
.draw{stroke-dasharray:1;stroke-dashoffset:1;animation:drawLine 1.4s cubic-bezier(.4,0,.2,1) .3s forwards}
@keyframes drawLine{to{stroke-dashoffset:0}}
.areaIn{animation:fadeIn .8s ease 1.1s both}
.lift{transition:transform .2s ease,box-shadow .2s ease}
.lift:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,37,77,.06),0 18px 40px rgba(0,37,77,.12)!important}
.frow{transition:background-color .15s ease}
.frow:hover{background-color:#F2F5FA!important}
@media (prefers-reduced-motion: reduce){.grow,.notch,.pulse,.pulse2,.areaIn{animation:none}.draw{animation:none;stroke-dashoffset:0}.lift,.lift:hover{transition:none;transform:none}}
</style>
</head>
<body>
<div id="app"></div>
<script>
(function () {
  'use strict';
  // ------------------------------------------------------------------ constants
  const DAY = 864e5, START = Date.UTC(2026, 6, 1), END = Date.UTC(2026, 10, 8);
  const N = Math.round((END - START) / DAY) + 1;
  const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const MONL = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const WDN = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  const MK0 = 2026 * 12 + 6, MK1 = 2026 * 12 + 10;
  const TICKET = 33.2213 / 3607;
  const SN = ['Offer generated','Offer reviewed','Offer selected','Offer accepted','Disb. initiated','Disb. completed','Booked in core'];
  const G = [18537, 14210, 9860, 6420, 4105, 3816, 3607];

  const esc = (v) => String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  const dd = (t) => { const d = new Date(t); return d.getUTCDate() + ' ' + MON[d.getUTCMonth()]; };
  const ddy = (t) => dd(t) + ' ' + new Date(t).getUTCFullYear();
  const fmt = (n) => Math.round(n).toLocaleString('en-IN');
  const mStart = (k) => Date.UTC(Math.floor(k / 12), k % 12, 1);
  const mEnd = (k) => Date.UTC(Math.floor(k / 12), k % 12 + 1, 0);
  const mKeyOf = (t) => { const d = new Date(t); return d.getUTCFullYear() * 12 + d.getUTCMonth(); };
  // Weeks are month-based: 1-7, 8-14, 15-21, 22-28, 29-month end
  const monOf = (t) => { const d = new Date(t); return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), 1 + Math.floor((d.getUTCDate() - 1) / 7) * 7); };
  const wEnd = (ws) => Math.min(ws + 6 * DAY, mEnd(mKeyOf(ws)));
  const wNo = (ws) => Math.floor((new Date(ws).getUTCDate() - 1) / 7) + 1;
  const wPrev = (ws) => { if (new Date(ws).getUTCDate() > 1) return ws - 7 * DAY; const pk = mKeyOf(ws) - 1; const dim = new Date(mEnd(pk)).getUTCDate(); return Date.UTC(Math.floor(pk / 12), pk % 12, 1 + Math.floor((dim - 1) / 7) * 7); };
  const wName = (ws) => 'Week ' + wNo(ws) + ' of ' + MON[new Date(ws).getUTCMonth()];
  const wSpan = (ws) => new Date(ws).getUTCDate() + '–' + dd(wEnd(ws));
  const idx = (t) => Math.max(0, Math.min(N - 1, Math.round((t - START) / DAY)));
  const pill = (on) => ({ bg: on ? '#003874' : '#FFFFFF', fg: on ? '#FFFFFF' : '#003874' });
  let INTRO = 0, FIRST = true;
  const pill2 = (on) => ({ bg: on ? '#003874' : 'transparent', fg: on ? '#FFFFFF' : '#0E2240' });
  const rnd = (i, k) => { const x = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453; return x - Math.floor(x); };

  // ------------------------------------------------------------------ mock daily data
  const gst = G.map((x, i) => i ? x / G[i - 1] : 1);
  const DAYS = (function () {
    const days = [];
    const nov1 = Math.round((Date.UTC(2026, 10, 1) - START) / DAY);
    const OV = { 0: [3910, 760], 1: [3620, 702], 2: [3405, 668], 3: [3880, 751], 4: [3722, 726] };
    for (let i = 0; i < N; i++) {
      const t = START + i * DAY, wd = new Date(t).getUTCDay();
      let p = 3350 + i * 2.2;
      if (wd === 0 || wd === 6) p *= 0.8;
      if (t >= Date.UTC(2026, 9, 15)) p *= 1.08;
      p *= 0.92 + 0.16 * rnd(i, 1);
      const ov = OV[i - nov1];
      if (ov) p = ov[0];
      const age = N - 1 - i;
      const c = [Math.round(p)];
      for (let k = 1; k < 7; k++) {
        let st = gst[k] * (0.96 + 0.08 * rnd(i, k + 2)) * (1 + (i - N / 2) * 0.0002);
        if (age < 3 && k >= 3) st *= 0.6 + 0.13 * age;
        c.push(c[k - 1] * Math.min(0.99, st));
      }
      if (ov) { const f = ov[1] / c[6]; for (let k = 1; k < 7; k++) c[k] *= Math.pow(f, k / 6); c[6] = ov[1]; }
      for (let k = 5; k >= 1; k--) c[k] = Math.max(c[k], c[k + 1]);
      for (let k = 1; k < 7; k++) c[k] = Math.min(c[k], c[k - 1]);
      days.push({ t, c, amtPer: TICKET * (0.95 + 0.1 * rnd(i, 11)) });
    }
    return days;
  })();

  // ------------------------------------------------------------------ filters
  const D = (g, label, code, opts, q) => ({ g, label, code, opts, q });
  const DEF = [
    D('chan','Journey channel','unified_journey_channel__c',['Mobile app','Net banking','Web','RM-assisted'],[1.25,1.0,0.7,1.35]),
    D('chan','Resume channel','unified_resume_journey_channel__c',['Same channel','App resume','Web resume','Assisted resume']),
    D('chan','Campaign code','campaign_code__c',Array.from({ length: 240 }, (_, i) => 'PA_' + ['FEST','AON','PUSH','RET','XSELL'][i % 5] + '_' + String(i + 1).padStart(3, '0'))),
    D('chan','UTM source','utm_source__c',['Google','Meta','SMS','Email','Direct']),
    D('chan','UTM medium','utm_medium__c',['cpc','push','sms','email']),
    D('chan','UTM campaign','utm_campaign__c',Array.from({ length: 180 }, (_, i) => 'pa_' + ['diwali','always_on','preapproved','topup','reactivation','salary_day'][i % 6] + '_' + String(i + 1).padStart(3, '0'))),
    D('out','Dropped reason','unified_dropped_reason__c',['None','Rate concern','Amount concern','Technical error','Customer dropped'],[1.6,0.5,0.55,0.6,0.4]),
    D('out','On-hold reason','unified_on_hold_reason__c',['None','KYC pending','Mandate pending','Manual review'],[1.2,0.6,0.7,0.8]),
    D('out','Reject reason','reject_reason__c',['None','Policy reject','Bureau reject','Fraud check'],[1.15,0.3,0.35,0.3]),
    D('cust','FT type','ft_type',['FT','Non-FT']),
    D('cust','Offer amount','offer_amt_bkt',['< 1 L','1–3 L','3–5 L','5–10 L','10 L+'],[0.8,1.1,1.15,1.0,0.85]),
    D('cust','Offer ROI','offer_roi_bkt',['< 11%','11–13%','13–15%','15%+'],[1.4,1.15,0.9,0.65]),
    D('cust','CIBIL score','cibil_score_bkt',['< 650','650–699','700–749','750–799','800+'],[0.45,0.7,0.95,1.2,1.5]),
    D('cust','Occupation','occupation',['Salaried','Self-employed','Professional','Others'],[1.1,0.8,1.0,0.7]),
    D('cust','Tenure','tenure_bkt',['≤ 12 m','13–24 m','25–36 m','37–60 m']),
    D('cust','PL decile','pl_decile_bkt',['D1–D2','D3–D4','D5–D6','D7–D8','D9–D10'],[1.45,1.15,0.95,0.8,0.6]),
    D('cust','811 account','acct_811_tag',['811','Non-811'],[1.2,0.9]),
    D('cust','RM-assisted','rm_assisted_conversion',['Yes','No'],[1.35,0.9]),
    D('dyn','Funnel stage (furthest)','funnel_stage',['OFFER_GENERATED','OFFER_REVIEW','OFFER_SELECTED','OFFER_ACCEPTED','DISBURSEMENT_INITIATED','DISBURSEMENT_COMPLETED','BOOKED_IN_CORE']),
    D('dyn','Stage name','stagename',['Open','In progress','Closed won','Closed lost']),
    D('dyn','OCC disposition','occ_disposition__c',['Interested','Not reachable','Not interested','Converted on call'],[1.2,0.6,0.4,1.6]),
    D('dyn','Digital activity','digital_activeness_flag',['Active','Semi-active','Inactive'],[1.4,0.9,0.45])
  ];
  const byCode = {}; DEF.forEach(d => { byCode[d.code] = d; });
  const hash = (str) => { let x = 7; for (let i = 0; i < str.length; i++) x = (x * 31 + str.charCodeAt(i)) >>> 0; return (x % 1000) / 1000; };
  const meta = (d) => {
    const w = d.opts.map(o => 0.5 + hash(d.code + o));
    const sw = w.reduce((a, b) => a + b, 0);
    return d.opts.map((o, j) => ({ val: o, share: w[j] / sw, q: d.q ? d.q[j] : 0.7 + 0.6 * hash(o + d.code) }));
  };

  // ------------------------------------------------------------------ state
  const S = {
    pgran: 'day', pDay: END, pWeek: Date.UTC(2026, 10, 8), pMonth: MK1, cFrom: END - 29 * DAY, cTo: END, cph: 'start', pcal: false, pcY: null, pcM: null,
    tgran: 'day', tdFrom: END - 29 * DAY, tdTo: END, twFrom: Date.UTC(2026, 8, 1), twTo: Date.UTC(2026, 10, 8), tmFrom: MK0, tmTo: MK1, tph: 'start', tcal: false, tcY: null, tcM: null,
    ex: false, q: '', f: {}, open: { pin: true }, sel: null, dd: null, ddq: '', ddFocus: false,
    mixVar: 'unified_journey_channel__c', mixFrom: 0, mixTo: 6,
    tview: 'chart', tmode: 'ratio', metric: 'p1', num: 'bk', den: 'p1', hov: null
  };
  const set = (o) => { Object.assign(S, o); render(); };

  // ------------------------------------------------------------------ compute view model
  function compute() {
    const s = S;
    const applied = Object.keys(s.f).filter(c => s.f[c] && s.f[c].length);
    let F = s.ex ? 0.97 : 1, Q = 1;
    applied.forEach(c => {
      const ms = meta(byCode[c]).filter(x => s.f[c].indexOf(x.val) >= 0);
      const sh = ms.reduce((a, m) => a + m.share, 0);
      F *= sh; Q *= ms.reduce((a, m) => a + m.share * m.q, 0) / (sh || 1);
    });
    const qf = Math.pow(Q, 0.35);
    const fd = DAYS.map(d => {
      const c = [d.c[0] * F];
      for (let k = 1; k < 7; k++) c.push(c[k - 1] * Math.min(0.99, (d.c[k] / d.c[k - 1]) * qf));
      c.push(c[6] * d.amtPer);
      return c;
    });
    const toggleF = (code, val) => { const f = Object.assign({}, S.f); const cur = (f[code] || []).slice(); const k = cur.indexOf(val); if (k >= 0) cur.splice(k, 1); else cur.push(val); f[code] = cur; set({ f, hov: null }); };
    const clearF = (code) => { const f = Object.assign({}, S.f); f[code] = []; set({ f, hov: null }); };
    const qq = s.q.trim().toLowerCase();
    const mkF = (d) => {
      const cur = s.f[d.code] || [];
      const open = s.dd === d.code;
      const dq = (s.ddq || '').trim().toLowerCase();
      const shownVals = open ? d.opts.filter(o => !dq || o.toLowerCase().indexOf(dq) >= 0) : [];
      const summary = !cur.length ? 'Any value' : cur.length <= 2 ? cur.join(', ') : cur.slice(0, 2).join(', ') + ' +' + (cur.length - 2) + ' more';
      return {
        label: d.label, code: d.code, n: cur.length, total: d.opts.length, open, summary, clear: () => clearF(d.code),
        toggle: () => set({ dd: S.dd === d.code ? null : d.code, ddq: '', ddFocus: S.dd !== d.code }),
        sel: cur.slice(0, 8).map(v => ({ val: v, remove: () => toggleF(d.code, v) })), more: Math.max(0, cur.length - 8),
        shown: shownVals.map(o => ({ val: o, on: cur.indexOf(o) >= 0, pick: () => toggleF(d.code, o) })),
        shownN: shownVals.length,
        selectShown: () => { const f = Object.assign({}, S.f); const c2 = (f[d.code] || []).slice(); shownVals.forEach(v => { if (c2.indexOf(v) < 0) c2.push(v); }); f[d.code] = c2; set({ f, hov: null }); },
        close: () => set({ dd: null, ddq: '' })
      };
    };
    const PIN = ['cibil_score_bkt','offer_amt_bkt','unified_journey_channel__c','digital_activeness_flag'];
    const secDefs = [
      { id: 'pin', name: 'Pinned', note: 'most used', list: PIN.map(c => byCode[c]) },
      { id: 'chan', name: 'Channel and campaign', note: '', list: DEF.filter(d => d.g === 'chan' && PIN.indexOf(d.code) < 0) },
      { id: 'cust', name: 'Customer and offer', note: '', list: DEF.filter(d => d.g === 'cust' && PIN.indexOf(d.code) < 0) },
      { id: 'out', name: 'Outcome reasons', note: '', list: DEF.filter(d => d.g === 'out') },
      { id: 'dyn', name: 'Dynamic', note: 'as of end date', list: DEF.filter(d => d.g === 'dyn' && PIN.indexOf(d.code) < 0) }
    ];
    const sections = secDefs.map(sd => {
      const list = qq ? sd.list.filter(d => (d.label + ' ' + d.code).toLowerCase().indexOf(qq) >= 0) : sd.list;
      const open = qq ? true : !!s.open[sd.id];
      const active = sd.list.filter(d => s.f[d.code] && s.f[d.code].length).length;
      return { name: sd.name, note: sd.note, items: list.map(mkF), show: list.length > 0, open, rot: open ? 90 : 0, active,
        toggle: () => { const o = Object.assign({}, S.open); o[sd.id] = !o[sd.id]; set({ open: o }); } };
    });
    const chips = applied.map(c => { const v = s.f[c]; return { label: byCode[c].label, val: v.length > 2 ? v.slice(0, 2).join(', ') + ' +' + (v.length - 2) : v.join(', '), remove: () => clearF(c) }; });

    // pickers
    const buildCells = (y, m, o) => {
      const first = Date.UTC(y, m, 1), dim = new Date(Date.UTC(y, m + 1, 0)).getUTCDate(), lead = (new Date(first).getUTCDay() + 6) % 7;
      const out = [];
      for (let k = 0; k < 42; k++) {
        const dn = k - lead + 1;
        if (dn < 1 || dn > dim) { out.push({ label: '', dis: true, aria: '', bg: 'transparent', fg: '#8A94A3', fw: 400, pick: () => {} }); continue; }
        const t = Date.UTC(y, m, dn), dis = t < START || t > END, sel = o.sel(t), inR = !sel && o.inR(t);
        out.push({ label: String(dn), dis, aria: WDN[new Date(t).getUTCDay()] + ' ' + ddy(t), fw: sel ? 600 : 400, bg: sel ? '#003874' : (inR ? '#E6EDF6' : 'transparent'), fg: dis ? '#B4BCC8' : (sel ? '#FFFFFF' : '#0E2240'), pick: () => o.pick(t) });
      }
      while (out.length > 35 && out.slice(-7).every(c => c.label === '')) out.splice(-7);
      return out;
    };
    const buildNav = (k, setK) => ({ title: MONL[k % 12] + ' ' + Math.floor(k / 12), prevDis: k <= MK0, nextDis: k >= MK1, prev: () => setK(k - 1), next: () => setK(k + 1) });
    const buildWeeks = (k, o) => {
      const out = [];
      for (let mon = mStart(k); mon <= mEnd(k); mon += 7 * DAY) {
        const sun = wEnd(mon), dis = sun < START || mon > END, sel = o.sel(mon), inR = !sel && o.inR(mon);
        const partial = !dis && (mon < START || sun > END);
        out.push({ label: 'Week ' + wNo(mon) + ': ' + wSpan(mon), sub: dis ? 'No data' : (partial ? 'Data to ' + dd(Math.min(sun, END)) : (Math.round((sun - mon) / DAY) + 1) + ' days'), dis,
          bg: sel ? '#003874' : (inR ? '#E6EDF6' : '#FFFFFF'), fg: sel ? '#FFFFFF' : (dis ? '#B4BCC8' : '#0E2240'), subFg: sel ? '#E6EDF6' : '#5A6472', border: sel ? '#003874' : '#E3E7ED', pick: () => o.pick(mon) });
      }
      return out;
    };
    const buildMonths = (o) => MON.map((label, m) => {
      const k = 2026 * 12 + m, dis = k < MK0 || k > MK1, sel = o.sel(k), inR = !sel && o.inR(k);
      return { label, dis, bg: sel ? '#003874' : (inR ? '#E6EDF6' : '#FFFFFF'), fg: sel ? '#FFFFFF' : (dis ? '#B4BCC8' : '#0E2240'), border: sel ? '#003874' : '#E3E7ED', pick: () => o.pick(k) };
    });

    // page period
    const pg = s.pgran;
    let pFrom, pTo, prevFrom, prevTo, prevName, pLabel;
    if (pg === 'day') {
      pFrom = pTo = s.pDay; prevFrom = prevTo = s.pDay - 7 * DAY; prevName = WDN[new Date(prevFrom).getUTCDay()] + ' ' + dd(prevFrom);
      pLabel = WDN[new Date(s.pDay).getUTCDay()] + ', ' + ddy(s.pDay) + (s.pDay === END ? ' (latest)' : '');
    } else if (pg === 'week') {
      const mon = s.pWeek, we = wEnd(mon); pFrom = Math.max(mon, START); pTo = Math.min(we, END);
      const pw = wPrev(mon); prevFrom = pw; prevTo = Math.min(pw + Math.round((pTo - pFrom) / DAY) * DAY, wEnd(pw));
      const part = pTo < we;
      prevName = 'previous week';
      pLabel = wName(mon) + ' ' + new Date(mon).getUTCFullYear() + ' (' + wSpan(mon) + (part ? ', data to ' + dd(pTo) : '') + ')';
    } else if (pg === 'month') {
      const k = s.pMonth; pFrom = Math.max(mStart(k), START); pTo = Math.min(mEnd(k), END);
      const len = Math.round((pTo - pFrom) / DAY);
      prevFrom = mStart(k - 1); prevTo = Math.min(prevFrom + len * DAY, mEnd(k - 1));
      const part = pTo < mEnd(k);
      prevName = part ? 'same days of ' + MON[(k - 1) % 12] : MONL[(k - 1) % 12];
      pLabel = MONL[k % 12] + ' ' + Math.floor(k / 12) + (part ? ' (1–' + new Date(pTo).getUTCDate() + ' ' + MON[k % 12] + ')' : '');
    } else {
      pFrom = Math.min(s.cFrom, s.cTo); pTo = Math.max(s.cFrom, s.cTo);
      const L = Math.round((pTo - pFrom) / DAY) + 1;
      prevTo = pFrom - DAY; prevFrom = prevTo - (L - 1) * DAY; prevName = 'previous ' + L + (L === 1 ? ' day' : ' days');
      pLabel = (pFrom === pTo ? ddy(pFrom) : dd(pFrom) + ' – ' + ddy(pTo)) + ' (' + L + (L === 1 ? ' day)' : ' days)');
    }
    const sumR = (a, b) => { const t = [0,0,0,0,0,0,0,0]; for (let i = a; i <= b; i++) for (let k = 0; k < 8; k++) t[k] += fd[i][k]; return t; };
    const tot = sumR(idx(pFrom), idx(pTo));
    const prevTot = prevFrom >= START ? sumR(idx(prevFrom), idx(prevTo)) : null;

    const pcK = s.pcY != null ? s.pcY * 12 + s.pcM : mKeyOf(pg === 'week' ? s.pWeek : pg === 'custom' ? s.cTo : s.pDay);
    const pNav = buildNav(pcK, (k) => set({ pcY: Math.floor(k / 12), pcM: k % 12 }));
    let pCells = [], pWeeks = [], pMonths = [], cEnds = [], cPresets = [], pTitle = '', pHint = '', pQuick = null;
    if (pg === 'day') {
      pTitle = 'Pick a day';
      pCells = buildCells(Math.floor(pcK / 12), pcK % 12, { sel: (t) => t === s.pDay, inR: () => false, pick: (t) => set({ pDay: t, pcal: false }) });
      pHint = 'One click picks the day.';
      if (s.pDay !== END) pQuick = { label: 'Latest day', pick: () => set({ pDay: END, pcal: false, pcY: null, pcM: null }) };
    } else if (pg === 'week') {
      pTitle = 'Pick a week';
      pWeeks = buildWeeks(pcK, { sel: (mon) => mon === s.pWeek, inR: () => false, pick: (mon) => set({ pWeek: mon, pcal: false }) });
      pHint = 'Weeks run 1–7, 8–14, 15–21, 22–28 and 29 to month end.';
      if (s.pWeek !== monOf(END)) pQuick = { label: 'Latest week', pick: () => set({ pWeek: monOf(END), pcal: false, pcY: null, pcM: null }) };
    } else if (pg === 'month') {
      pTitle = 'Pick a month';
      pMonths = buildMonths({ sel: (k) => k === s.pMonth, inR: () => false, pick: (k) => set({ pMonth: k, pcal: false }) });
      pHint = 'Months with data are July to November.';
      if (s.pMonth !== MK1) pQuick = { label: 'Current month', pick: () => set({ pMonth: MK1, pcal: false }) };
    } else {
      pTitle = 'Pick a custom range';
      const cf = Math.min(s.cFrom, s.cTo), ct = Math.max(s.cFrom, s.cTo), ph = s.cph;
      pCells = buildCells(Math.floor(pcK / 12), pcK % 12, { sel: (t) => t === cf || t === ct, inR: (t) => t > cf && t < ct, pick: (t) => {
        if (ph === 'start') set({ cFrom: t, cTo: t > ct ? t : ct, cph: 'end' });
        else if (t < cf) set({ cFrom: t, cTo: cf, cph: 'start' });
        else set({ cFrom: cf, cTo: t, cph: 'start' });
      } });
