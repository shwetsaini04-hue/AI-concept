# --- Database -------------------------------------------------------------
# SQLite (default, zero setup) or PostgreSQL, e.g.
# DATABASE_URL=postgresql://lab:lab@localhost:5432/transcript_lab
# On Vercel, set a hosted Postgres URL (e.g. Neon). Without it, SQLite falls back to /tmp,
# which is wiped between invocations — progress sync would not persist.
DATABASE_URL=sqlite:///./data/transcript_lab.db

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- LLM providers (all optional; the app works without any) --------------
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local / self-hosted OpenAI-compatible server (e.g. Ollama: http://localhost:11434/v1)
LOCAL_BASE_URL=
LOCAL_MODEL=llama3.1:8b

# Safety limits for the learning lab
MAX_OUTPUT_TOKENS=1024
REQUEST_TIMEOUT_SECONDS=60
